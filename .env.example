# Plantilla de credenciales. Copiala a .env y completa los valores:
#
#   cp .env.example .env
#
# El archivo .env esta en .gitignore: nunca se sube al repositorio.
# Este si se sube, y no tiene ningun valor real.

# URL de la API de m6dev
API_URL=https://m6dev.farma-erp.cl/api/v1

# Credencial de la usuaria de prueba (rol EJECUTIVA, no administrador).
# Formato: USUARIO:CLAVE
API_AUTH=USUARIO:CLAVE

# Ruta al modulo que se quiere probar, relativa a donde se corre el comando.
# Se usa para apuntar al archivo del proyecto, no al del servidor.
MODULO_10416=../en-servidor/client/custom/src/utils/elegibilidadFin.js
